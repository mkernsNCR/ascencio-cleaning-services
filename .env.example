# Copy to .env (never commit real values). All secrets belong in the host's secret manager.

# --- Core -------------------------------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://localhost/ascencio_dev
# Public origin used in email links and OAuth redirects. Must be https in production.
PUBLIC_BASE_URL=http://localhost:5000
# 32+ random characters. Required in production. e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Behind a proxy/load balancer that terminates TLS (Replit, Render, etc.)
TRUST_PROXY=false

# --- Feature flags ----------------------------------------------------------------------------
# Set to false to pause online requests (the site offers the contact/quote fallback instead).
BOOKING_ENABLED=true
# Run the background worker inside the web process. Set false on web instances when running
# `npm run worker` as a separate process.
RUN_WORKER=true

# --- Email (Gmail SMTP by default) ------------------------------------------------------------
# "smtp" sends real mail; "log" records messages without sending (default outside production).
MAIL_TRANSPORT=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ascenciocleaning@gmail.com
# Gmail App Password (requires 2-Step Verification on the account)
SMTP_PASSWORD=
MAIL_FROM="Ascencio Cleaning Services <ascenciocleaning@gmail.com>"
OWNER_NOTIFICATION_EMAIL=ascenciocleaning@gmail.com
# Optional separate address for integration/delivery failure alerts (defaults to owner email)
STAFF_ALERT_EMAIL=

# --- Google Calendar --------------------------------------------------------------------------
# "google" uses the real API (required in production). "fake" is an in-memory calendar for local
# development only (default outside production; requires RUN_WORKER=true in the same process).
GOOGLE_CALENDAR_MODE=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts the stored refresh token. e.g. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
# Enable push notifications (requires a publicly reachable https PUBLIC_BASE_URL)
GOOGLE_WEBHOOK_ENABLED=false
